# Lead Daddy app2: every environment variable the code reads. NAMES ONLY, never values.
# Copy to .env.local for local dev, or add each one in Vercel > Project > Settings >
# Environment Variables. Never commit real values (.env* is git-ignored except this file).
#
# REQUIRED marks what the app needs to load at all (unless demo mode is on). Everything else is optional: the
# feature that uses it shows a plain "not available" message when it's missing.
# On Vercel *preview* links, texts, calls, emails and paid verifications are OFF no matter
# which keys are set (src/lib/channels/send-guard.ts). See docs/VERCEL_PREVIEW_SETUP.md.

# ── Demo mode ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_LEAD_DADDY_DEMO_MODE=     # "true" runs on built-in sample data with a demo sign-in, NO Supabase
                                      # needed. Sends always off. Never set it on the live app.

# ── Database and login (Supabase) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # REQUIRED. Project URL, https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # REQUIRED. Public anon key (sent to browsers)
SUPABASE_SERVICE_ROLE_KEY=           # REQUIRED for any data. Full database access: server only, guard it
LEADDADDY_ORGANIZATION_ID=           # Org whose data the app shows. Default: the Go Buy Leads org
ALLOWED_EMAILS=                      # Comma separated logins allowed in. Default: steve@ and mykoal@ loandaddy.ai

# ── Safety switches ────────────────────────────────────────────────────────
LEAD_DADDY_ALLOW_PREVIEW_SENDS=      # "true" lets previews send and verify. Leave EMPTY for safe previews
LEAD_DADDY_DISABLE_SENDS=            # "true" turns sends and paid checks off everywhere, production too
CRON_SECRET=                         # Only for the campaign runner. Leave EMPTY on preview copies

# ── AI models (any one is enough) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
QWEN_API_KEY=
QWEN_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
MOONSHOT_API_KEY=
MOONSHOT_MODEL=
AI_MONTHLY_BUDGET_USD=               # Monthly AI spend cap

# ── Texts and calls (Twilio) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_DEFAULT_FROM=
TWILIO_SENDER_POOL=                  # Comma separated caller IDs for AI calls
APP_BASE_URL=                        # This deployment's https URL (needed for call webhooks)

# ── Email ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=                    # Used first when set
RESEND_API_KEY=                      # Fallback
EMAIL_FROM=                          # e.g. Lead Daddy <name@yourdomain.com>

# ── Verification (paid per check) ──────────────────────────────────────────
REOON_API_KEY=                       # Email checks
REALVALIDITO_API_KEY=                # Phone checks
VERIFY_EMAIL_CREDITS=                # Credits one email check costs (for the cost preview)
VERIFY_PHONE_CREDITS=

# ── Scraping and social ────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
COMPOSIO_API_KEY=

# ── Display ────────────────────────────────────────────────────────────────
LEAD_DADDY_TIME_ZONE=                # IANA name for exports, e.g. America/Phoenix (the default)
